#!/bin/bash
# Omarchy hook (post-update + post-boot): notice a new stock agents panel and
# dry-run our port. Never changes the live clone. Installed by:
#   omarchy hook install post-update hooks/agents-stock-check
#   omarchy hook install post-boot   hooks/agents-stock-check
# post-boot also catches stock changes that came in via a plain pacman -Syu.
CHECK="$HOME/Projects/hermes/plugins/omarchy-hermes-agents/scripts/check_stock_update.py"
[[ -f $CHECK ]] || exit 0
python3 "$CHECK" >/dev/null 2>&1 || true
