# ── Live limits fetchers ─────────────────────────────────────────────────────


def _jwt_payload(token):
    try:
        part = token.split(".")[1]
        part += "=" * (-len(part) % 4)
        return json.loads(base64.urlsafe_b64decode(part))
    except Exception:
        return {}


def _chatgpt_token_candidates(auth):
    """Collect openai-codex access tokens from default + profile auth.json files.

    Dedicated profile agents (voltti, straffesites, ...) run openai-codex
    traffic daily and refresh their own OAuth chains, while the default
    profile's chain can sit idle until its 10-day access token expires (or
    its refresh chain gets revoked). The wham/usage endpoint is account-level
    and read-only, so any fresh token FOR THE SAME ChatGPT account returns
    the same limits. Gather tokens from every auth.json, keep only the
    default token's account, sort freshest-first (JWT exp). Never refresh
    from the collector — refresh tokens are single-use and Hermes owns
    rotation.
    """
    def tokens_from(d):
        toks = []
        oc = d.get("providers", {}).get("openai-codex", {}) or {}
        t = (oc.get("tokens") or {}).get("access_token", "")
        if t:
            toks.append(t)
        for entry in d.get("credential_pool", {}).get("openai-codex", []) or []:
            if isinstance(entry, dict):
                t = entry.get("access_token", "")
                if t:
                    toks.append(t)
        return toks

    candidates = tokens_from(auth)
    if PROFILES_DIR.exists():
        for auth_path in sorted(PROFILES_DIR.glob("*/auth.json")):
            try:
                candidates.extend(tokens_from(json.loads(auth_path.read_text())))
            except Exception:
                continue

    # Dedupe, keep insertion order (default profile first).
    seen, uniq = set(), []
    for t in candidates:
        if t not in seen:
            seen.add(t)
            uniq.append(t)

    # Pin to the default profile's ChatGPT account when it has a token, so a
    # profile logged into a DIFFERENT account can never skew the meter.
    def account_of(t):
        return (_jwt_payload(t).get("https://api.openai.com/auth", {}) or {}).get("chatgpt_account_id")

    default_account = account_of(uniq[0]) if uniq else None
    if default_account:
        same = [t for t in uniq if account_of(t) == default_account]
        if same:
            uniq = same

    uniq.sort(key=lambda t: _jwt_payload(t).get("exp", 0), reverse=True)
    return uniq


def fetch_chatgpt_limits(auth):
    """Fetch rate limits from ChatGPT wham/usage API with Hermes-stored tokens.

    Returns (limits_list, tier_label, status_text, auth_help).
    Uses openai-codex access tokens from the default profile first, then
    falls back to fresh same-account tokens from dedicated profile auth.json
    files (read-only; see _chatgpt_token_candidates).
    """
    candidates = _chatgpt_token_candidates(auth)

    if not candidates:
        return [], "", "ChatGPT not authenticated", "Run `hermes auth add openai-codex --type oauth`"

    def call_api(access_token):
        url = "https://chatgpt.com/backend-api/wham/usage"
        headers = {
            "Authorization": f"Bearer {access_token}",
            "Accept": "application/json",
            "User-Agent": "codex-cli",
        }
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, timeout=15) as resp:
            return json.loads(resp.read())

    payload = None
    last_error = None
    saw_401 = False
    for token in candidates:
        try:
            payload = call_api(token)
            break
        except urllib.error.HTTPError as exc:
            last_error = exc
            if exc.code == 401:
                # Expired/revoked access token — try the next candidate.
                saw_401 = True
                continue
            return [], "", f"ChatGPT API error ({exc.code})", ""
        except Exception as exc:
            return [], "", "ChatGPT API unavailable", str(exc)

    if payload is None:
        if saw_401:
            # Every candidate 401'd: all OAuth chains (default + profiles)
            # are dead. Hermes refreshes lazily on real openai-codex use,
            # but a revoked refresh chain (refresh_token_reused in
            # providers.openai-codex.last_auth_error) needs a real re-login.
            return [], "", "ChatGPT token expired on all profiles", "Run `hermes auth add openai-codex --type oauth`"
        return [], "", f"ChatGPT API error ({last_error.code})", "" if last_error else ""

    try:
        plan = str(payload.get("plan_type") or "").strip()
        tier_label = plan.capitalize() if plan else ""

        rate_limit = payload.get("rate_limit") or {}
        limits = []

        # Free plan reports a 30-day window (2592000s) with no secondary
        # window; the label logic below derives "Monthly (30-day)" from the
        # span so it sorts into the panel's Monthly bucket.
        for key, label in (("primary_window", "Weekly (7-day)"), ("secondary_window", "Secondary")):
            window = rate_limit.get(key)
            if not isinstance(window, dict):
                continue
            used = window.get("used_percent")
            if used is None:
                continue
            window_seconds = int(window.get("limit_window_seconds") or 0)
            if window_seconds:
                hours = window_seconds // 3600
                if hours >= 672:
                    # 28 days or more: free plans report a 30-day window
                    # (2592000s). Panel.qml buckets "month"/"30-day" labels
                    # as Monthly with a 30d span.
                    label = "Monthly (30-day)"
                elif hours >= 168:
                    label = "Weekly (7-day)"
                elif hours > 0:
                    label = f"{hours}h window"
                else:
                    label = f"{window_seconds // 60}m window"
            reset_at = window.get("reset_at")
            resets_iso = ""
            if reset_at:
                try:
                    resets_iso = datetime.fromtimestamp(int(reset_at), timezone.utc).isoformat()
                except Exception:
                    resets_iso = str(reset_at)
            limits.append({
                "label": label,
                "percent": float(used) / 100.0,
                "resetsAt": resets_iso,
            })

        # Free plans carry a credit balance (non-USD unit: ~62k for a small
        # allowance). There is no cap to draw a meter from, so surface it as
        # an info row: percent -1 renders as "—" with no meter fill, and the
        # windowTitle fallback names it from the label.
        credits = payload.get("credits") or {}
        if credits.get("has_credits"):
            try:
                balance = float(credits.get("balance") or 0)
            except (TypeError, ValueError):
                balance = 0.0
            if balance > 0:
                limits.append({
                    "label": f"Credits ({balance:,.0f})",
                    # Explicit title: windowTitle strips parenthesised suffixes,
                    # which would hide the balance behind the "—" value slot.
                    "title": f"Credits ({balance:,.0f})",
                    "percent": -1,
                    "resetsAt": "",
                })

        return limits, tier_label, "", ""
    except Exception as exc:
        return [], "", "ChatGPT API unavailable", str(exc)


ANTHROPIC_USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
CLAUDE_CREDENTIALS = Path.home() / ".claude" / ".credentials.json"


def _claude_cli_login():
    """Read the claude CLI OAuth login (read-only).

    `claude auth login` writes claudeAiOauth into ~/.claude/.credentials.json;
    only the CLI itself refreshes that token (it rewrites the file whenever
    it runs). The collector therefore never rotates it — same rule as the
    openai-codex chain Hermes owns.
    """
    try:
        data = json.loads(CLAUDE_CREDENTIALS.read_text())
    except Exception:
        return {}
    login = data.get("claudeAiOauth")
    return login if isinstance(login, dict) else {}


def _anthropic_percent(value, percent_scale):
    """Anthropic reports utilization as a percent (37.0 or 1.0 = 1%)."""
    try:
        n = float(str(value).strip().replace("%", ""))
    except (TypeError, ValueError):
        return -1.0
    if not (n >= 0):
        return -1.0
    if percent_scale or n > 1:
        return min(1.0, n / 100.0)
    return min(1.0, n)


def fetch_claude_cli_limits(auth):
    """READ-ONLY limits fetch from Anthropic's OAuth usage endpoint, using
    the claude CLI login (this machine's Claude-subscription auth source).

    Endpoint/headers mirror the stock omarchy-agent-usage-claude collector:
    GET https://api.anthropic.com/api/oauth/usage with Bearer access token
    and the oauth-2025-04-20 beta header. Session (5-hour) + Weekly (7-day)
    meters come from five_hour/seven_day (the oauth-apps view when present);
    scoped per-model windows (e.g. "Fable Weekly") from limits[]; and the
    extra-usage credits spend cap (EUR on this account) becomes a meter of
    its own so the panel tracks it before it locks the account.

    NEVER refresh tokens here: the claude CLI owns that credential file and
    rewrites it on its own runs. An expired token is surfaced honestly.

    Returns (limits_list, tier_label, status_text, auth_help).
    """
    login = _claude_cli_login()
    access_token = login.get("accessToken") or ""
    if not access_token:
        return [], "", "Claude CLI not logged in", "Run `claude auth login`"

    expires_at = login.get("expiresAt") or 0
    try:
        expires_at = float(expires_at)
        if expires_at > 1e12:
            expires_at /= 1000.0
    except (TypeError, ValueError):
        expires_at = 0
    if expires_at and expires_at <= time.time():
        return [], "", "Claude sign-in expired", "Start the claude CLI, or run `claude auth login`, to refresh it"

    req = urllib.request.Request(
        ANTHROPIC_USAGE_URL,
        headers={
            "Authorization": f"Bearer {access_token}",
            "anthropic-beta": "oauth-2025-04-20",
            "Accept": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            payload = json.loads(resp.read())
    except urllib.error.HTTPError as exc:
        if exc.code == 401:
            return [], "", "Claude token rejected", "Run `claude auth login`"
        if exc.code == 429:
            return [], "", "Anthropic usage endpoint rate limiting checks", ""
        return [], "", f"Anthropic API error ({exc.code})", ""
    except Exception as exc:
        # Transient marker word keeps the panel's retryAdvised 30s retry.
        return [], "", "Anthropic API unavailable", str(exc)

    def _bucket(payload, key):
        value = payload.get(key)
        if isinstance(value, dict) and value.get("utilization") is not None:
            return value
        return None

    session = _bucket(payload, "five_hour")
    weekly = _bucket(payload, "seven_day_oauth_apps") or _bucket(payload, "seven_day")

    # One payload speaks one convention; any value >= 1 means percent scale.
    raw = []
    if session:
        raw.append(session.get("utilization"))
    if weekly:
        raw.append(weekly.get("utilization"))
    entries = payload.get("limits")
    if isinstance(entries, list):
        raw += [e.get("percent") for e in entries if isinstance(e, dict)]
    numbers = []
    for v in raw:
        try:
            numbers.append(float(str(v).strip().replace("%", "")))
        except (TypeError, ValueError):
            pass
    percent_scale = any(n >= 1 for n in numbers)

    def _resets_iso(value):
        raw = str(value or "").strip()
        if not raw:
            return ""
        try:
            return datetime.fromisoformat(raw.replace("Z", "+00:00")).isoformat()
        except Exception:
            return raw

    limits = []
    if session is not None:
        percent = _anthropic_percent(session.get("utilization"), percent_scale)
        if percent >= 0:
            limits.append({
                "label": "Session (5-hour)",
                "percent": percent,
                "resetsAt": _resets_iso(session.get("resets_at")),
            })
    if weekly is not None:
        percent = _anthropic_percent(weekly.get("utilization"), percent_scale)
        if percent >= 0:
            limits.append({
                "label": "Weekly (7-day)",
                "percent": percent,
                "resetsAt": _resets_iso(weekly.get("resets_at")),
            })

    # Scoped per-model weekly windows (e.g. Fable) — free-floating titles.
    if isinstance(entries, list):
        for entry in entries:
            if not isinstance(entry, dict) or entry.get("kind") != "weekly_scoped":
                continue
            percent = _anthropic_percent(entry.get("percent"), percent_scale)
            if percent < 0:
                continue
            scope = entry.get("scope")
            model = scope.get("model", {}) if isinstance(scope, dict) else {}
            name = str(model.get("display_name") or model.get("id") or "").strip()
            if not name:
                continue
            title = f"{name} Weekly"
            limits.append({
                "label": title,
                "title": title,
                "percent": percent,
                "resetsAt": _resets_iso(entry.get("resets_at")),
            })

    # Extra usage credits (purchased overage, e.g. EUR spend cap). This is
    # the meter that locks the account when it fills — surface it so the
    # panel tracks it before it does.
    extra = payload.get("extra_usage")
    if isinstance(extra, dict) and extra.get("is_enabled"):
        try:
            used = float(extra.get("used_credits") or 0)
            cap = float(extra.get("monthly_limit") or 0)
        except (TypeError, ValueError):
            used, cap = 0.0, 0.0
        if cap > 0:
            currency = str(extra.get("currency") or "")
            limits.append({
                "label": f"Extra credits ({used:.0f}/{cap:.0f} {currency})",
                "percent": min(max(used / cap, 0.0), 1.0),
                "resetsAt": "",
            })

    tier_label = ""
    subscription = str(login.get("subscriptionType") or "")
    if subscription:
        tier_label = subscription[0].upper() + subscription[1:]
    return limits, tier_label, "", ""


LIMIT_FETCHERS = {
    "fetch_chatgpt_limits": fetch_chatgpt_limits,
    "fetch_claude_cli_limits": fetch_claude_cli_limits,
}


# ── Transient-network resilience ─────────────────────────────────────────────
# The panel shows usageStatusText/authHelpText as a scary red banner and drops
# all limit meters whenever a limits fetch fails. A single DNS hiccup (e.g. the
# OnBootSec=30s run racing system DNS at boot) or a brief provider outage then
# wipes healthy data. Mitigate in three layers:
#   1. Retry transient failures once after 5s (covers post-boot DNS warmup).
#   2. On persistent failure, keep serving the last good limits from a cache
#      file (staleness capped at 2h; afterwards the error wins).
#   3. Tag the status text so the panel says "cached" instead of "unavailable".
# NOTE: keep this OUTSIDE the usage/ directory — the panel scans usage/ for
# *.json and would try to render the cache as a provider tab.
LIMITS_CACHE_PATH = Path.home() / ".local" / "state" / "omarchy" / "agents" / "limits-cache.json"
LIMITS_CACHE_MAX_AGE_S = 2 * 60 * 60  # 2h


def _is_transient_fetch_error(status_text, auth_help):
    """True when a fetch failure looks like a transient network problem
    (name resolution, connection, timeout) rather than bad credentials."""
    blob = f"{status_text} {auth_help}".lower()
    transient_markers = (
        "unavailable",          # "<Provider> API unavailable" / URLError branch
        "temporary failure",
        "name resolution",
        "name or service",
        "connection refused",
        "connection reset",
        "connection timed out",
        "timed out",
        "timeout",
        "ssl",
        "eof occurred",
        "remote end closed",
    )
    # Auth problems (invalid key, relogin) are never transient.
    if "invalid" in blob or "not authenticated" in blob or "relogin" in blob:
        return False
    return any(marker in blob for marker in transient_markers)


def _load_limits_cache():
    try:
        cached = json.loads(LIMITS_CACHE_PATH.read_text())
        if isinstance(cached, dict):
            return cached
    except Exception:
        pass
    return {}


def _store_cached_limits(cache, provider_id, entry):
    cache[provider_id] = entry
    try:
        tmp = LIMITS_CACHE_PATH.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(cache, indent=2))
        tmp.replace(LIMITS_CACHE_PATH)
    except Exception:
        pass  # cache is best-effort; never fail the collector over it


def fetch_limits_resilient(provider_id, fetcher, auth, allow_retry=True):
    """Run a limits fetcher with one transient retry and stale-limit caching.

    Returns (limits, tier_label, status_text, auth_help).
    Set allow_retry=False when the caller already has its own retry loop
    (the panel's retryAdvised 30s retry calls us with --limits-only).
    """
    limits, tier_label, status_text, auth_help = fetcher(auth)

    if limits or not status_text:
        _store_cached_limits(
            _load_limits_cache(),
            provider_id,
            {
                "limits": limits,
                "tierLabel": tier_label,
                "storedAt": time.time(),
            },
        )
        return limits, tier_label, status_text, auth_help

    # Fetch failed: retry once for transient-looking errors (post-boot DNS
    # warmup typically resolves within a few seconds). Skipped when the
    # caller runs its own retry loop (panel --limits-only mode).
    if allow_retry and _is_transient_fetch_error(status_text, auth_help):
        time.sleep(5)
        limits, tier_label, status_text, auth_help = fetcher(auth)
        if limits or not status_text:
            _store_cached_limits(
                _load_limits_cache(),
                provider_id,
                {
                    "limits": limits,
                    "tierLabel": tier_label,
                    "storedAt": time.time(),
                },
            )
            return limits, tier_label, status_text, auth_help

    # Still failing: serve cached limits if fresh enough AND the failure is
    # transient (network). Auth errors must surface honestly, not be masked
    # by stale meters.
    if not limits and status_text and _is_transient_fetch_error(status_text, auth_help):
        cached_entry = _load_limits_cache().get(provider_id)
        if isinstance(cached_entry, dict):
            age = time.time() - float(cached_entry.get("storedAt") or 0)
            cached_limits = cached_entry.get("limits")
            if age <= LIMITS_CACHE_MAX_AGE_S and isinstance(cached_limits, list) and cached_limits:
                cached_tier = cached_entry.get("tierLabel") or ""
                cached_status = f"{status_text} — showing cached limits"
                return cached_limits, cached_tier, cached_status, auth_help

    return limits, tier_label, status_text, auth_help


# ── Token usage from DB ──────────────────────────────────────────────────────


def _retry_advised(status_text, auth_help):
    """True when the panel should rerun this provider's limits fetch sooner.

    Only transient (network) failures advise a retry — the 30s panel retry
    then gives the fetch a second chance well before the next timer run.
    Auth errors advise nothing: a retry can't fix them.
    """
    return bool(status_text) and _is_transient_fetch_error(status_text, auth_help)


def collect_provider(conns, meta, auth):
    now = datetime.now().astimezone()
    today_str = now.strftime("%Y-%m-%d")
    recent_dates = [
        (now - timedelta(days=offset)).strftime("%Y-%m-%d")
        for offset in range(6, -1, -1)
    ]
    recent = {day: 0 for day in recent_dates}

    today_tokens_by_model = {}
    today_sessions = set()
    today_prompts = 0
    today_total_tokens = 0
    model_usage = {}
    active_dates = set()
    total_prompts = 0
    total_sessions = set()

    query = f"""
        SELECT
            smu.model,
            smu.input_tokens,
            smu.output_tokens,
            smu.cache_read_tokens,
            smu.cache_write_tokens,
            smu.api_call_count,
            smu.estimated_cost_usd,
            date(smu.first_seen, 'unixepoch', 'localtime') AS first_day,
            date(smu.last_seen, 'unixepoch', 'localtime') AS last_day,
            s.id AS session_id
        FROM session_model_usage smu
        JOIN sessions s ON s.id = smu.session_id
        WHERE {meta["where"]}
        """

    rows = []
    for db_idx, conn in enumerate(conns):
        db_rows = conn.execute(query, meta["params"]).fetchall()
        rows.extend((db_idx, row) for row in db_rows)

    for db_idx, row in rows:
        model, inp, outp, cr, cw, api_calls, cost, first_day, last_day, session_id = row
        session_key = (db_idx, session_id)
        inp = inp or 0
        outp = outp or 0
        cr = cr or 0
        cw = cw or 0
        total = inp + outp + cr + cw
        if total <= 0 and (api_calls or 0) <= 0:
            continue

        model_name = model or "unknown"

        bucket = model_usage.setdefault(model_name, empty_bucket())
        bucket["inputTokens"] += inp
        bucket["outputTokens"] += outp
        bucket["cacheReadInputTokens"] += cr
        bucket["cacheCreationInputTokens"] += cw

        prompts = max(api_calls or 0, 1)
        total_prompts += prompts
        total_sessions.add(session_key)

        if last_day:
            active_dates.add(last_day)
        if first_day:
            active_dates.add(first_day)

        if first_day and last_day:
            if first_day <= today_str <= last_day:
                today_prompts += prompts
                today_sessions.add(session_key)
                today_total_tokens += total
                today_tokens_by_model[model_name] = (
                    today_tokens_by_model.get(model_name, 0) + total
                )

        for day in recent_dates:
            if first_day and last_day and first_day <= day <= last_day:
                recent[day] += total

    # Fetch live limits (with transient retry + stale-limit caching so a
    # post-boot DNS hiccup or brief outage doesn't blank the panel).
    limits = []
    tier_label = meta["tierLabel"]
    status_text = ""
    auth_help = ""
    limits_fn_name = meta.get("limits_fn")
    if limits_fn_name and limits_fn_name in LIMIT_FETCHERS:
        limits, tier_label, status_text, auth_help = fetch_limits_resilient(
            meta["id"], LIMIT_FETCHERS[limits_fn_name], auth
        )

    record = {
        "schemaVersion": 1,
        "id": meta["id"],
        "name": meta["name"],
        "updatedAt": datetime.now(timezone.utc).isoformat(),
        "ready": len(rows) > 0,
        "hasLocalStats": True,
        "hasPromptStats": True,
        "scope": meta.get("scope", "machine"),
        "tierLabel": tier_label,
        "usageStatusText": status_text,
        "authHelpText": auth_help,
        "retryAdvised": _retry_advised(status_text, auth_help),
        "limits": limits,
        "todayPrompts": today_prompts,
        "todaySessions": len(today_sessions),
        "todayTotalTokens": today_total_tokens,
        "todayTokensByModel": today_tokens_by_model,
        "recentDays": [
            {"date": day, "messageCount": recent[day]} for day in recent_dates
        ],
        "totalPrompts": total_prompts,
        "totalSessions": len(total_sessions),
        "activeDays": len(active_dates),
        "activeDates": sorted(active_dates),
        "modelUsage": model_usage,
    }

    return record


def _refresh_limits_only(meta, auth):
    """Re-fetch only the limits for one provider and patch them into the
    existing record on disk. Token stats stay untouched — this is what the
    panel's --limits-only mode (open-panel refresh and retryAdvised retry)
    calls us with.
    """
    out_path = USAGE_DIR / f"{meta['id']}.json"
    try:
        record = json.loads(out_path.read_text())
        if not isinstance(record, dict):
            raise ValueError("not an object")
    except Exception:
        # No usable record yet: fall back to a full collect.
        record = None
    if record is None:
        print(f"limits-only: no usable {out_path.name}, skipping")
        return

    # Panel-triggered limits-only run: the panel's own 30s retryAdvised
    # loop is the retry, so no in-process sleep here.
    limits, tier_label, status_text, auth_help = fetch_limits_resilient(
        meta["id"], LIMIT_FETCHERS[meta["limits_fn"]], auth,
        allow_retry=False,
    )
    record["updatedAt"] = datetime.now(timezone.utc).isoformat()
    record["tierLabel"] = tier_label or record.get("tierLabel", "")
    record["usageStatusText"] = status_text
    record["authHelpText"] = auth_help
    record["retryAdvised"] = _retry_advised(status_text, auth_help)
    record["limits"] = limits

    tmp_path = USAGE_DIR / f".{meta['id']}.tmp"
    tmp_path.write_text(json.dumps(record, indent=2) + "\n")
    tmp_path.replace(out_path)
    print(
        f"Patch {out_path.name} "
        f"(limits-only, {len(limits)} limits)"
    )


def _parse_args(argv):
    """Parse the omarchy-agent-usage-update call convention:
    [--force] [--limits-only] [--except <id>]... [provider-id]...
    Returns (limits_only, only_ids, excluded_ids).
    """
    limits_only = False
    only_ids = set()
    excluded = set()
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--force":
            pass  # full run is the default here
        elif arg == "--limits-only":
            limits_only = True
        elif arg == "--except":
            i += 1
            if i < len(argv):
                excluded.add(argv[i])
        else:
            only_ids.add(arg)
        i += 1
    return limits_only, only_ids, excluded


def main():
    limits_only, only_ids, excluded = _parse_args(sys.argv[1:])

    if not STATE_DB.exists():
        print(f"hermes-usage-collector: {STATE_DB} not found", file=sys.stderr)
        return 1

    USAGE_DIR.mkdir(parents=True, exist_ok=True)
    auth = load_auth()

    conns = [open_db_ro(p) for p in state_dbs()]
    try:
        for meta in PROVIDERS:
            if only_ids and meta["id"] not in only_ids:
                continue
            if meta["id"] in excluded:
                continue
            if limits_only:
                _refresh_limits_only(meta, auth)
                continue
            record = collect_provider(conns, meta, auth)
            out_path = USAGE_DIR / f"{meta['id']}.json"
            tmp_path = USAGE_DIR / f".{meta['id']}.tmp"
            tmp_path.write_text(json.dumps(record, indent=2) + "\n")
            tmp_path.replace(out_path)
            print(
                f"Wrote {out_path.name} "
                f"({record['totalPrompts']} prompts, "
                f"{record['todayTotalTokens']} tokens today, "
                f"{len(record['limits'])} limits)"
            )
    finally:
        for conn in conns:
            conn.close()

    return 0


if __name__ == "__main__":
    sys.exit(main())