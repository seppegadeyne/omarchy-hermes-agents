#!/usr/bin/python3
"""Collect Hermes Agent usage from state.db into Omarchy agents panel records.

Reads the session_model_usage table from ~/.hermes/state.db and writes
display-ready JSON records for the claude-cli and chatgpt providers
into ~/.local/state/omarchy/agents/usage/ where the Omarchy agents panel
picks them up automatically.

Live limits:
- Claude: https://api.anthropic.com/api/oauth/usage with the claude CLI's
  own OAuth token (read-only; when it expires the collector lets the CLI
  refresh itself with one throttled headless turn).
- ChatGPT: https://chatgpt.com/backend-api/wham/usage with Hermes-stored tokens.
"""

import base64
import json
import os
import sqlite3
import sys
import time
import urllib.request
import urllib.error
import urllib.parse
from datetime import datetime, timedelta, timezone
from pathlib import Path

STATE_DB = Path.home() / ".hermes" / "state.db"
PROFILES_DIR = Path.home() / ".hermes" / "profiles"
AUTH_JSON = Path.home() / ".hermes" / "auth.json"
USAGE_DIR = Path.home() / ".local" / "state" / "omarchy" / "agents" / "usage"


def state_dbs():
    """All Hermes state DBs on this machine: default profile first, then
    every dedicated profile. Dedicated-profile agents (verhuurwinkel,
    straffesites, ...) log their token usage into their own state.db —
    skipping them undercounts models that are ONLY used there."""
    paths = [STATE_DB] if STATE_DB.exists() else []
    if PROFILES_DIR.is_dir():
        paths.extend(sorted(PROFILES_DIR.glob("*/state.db")))
    return paths


def open_db_ro(path):
    """Open a state.db strictly read-only: profile DBs are live databases
    owned by running gateway daemons; a read-write handle could contend
    with their write locks or journal files."""
    return sqlite3.connect(f"file:{path}?mode=ro&immutable=0", uri=True)




