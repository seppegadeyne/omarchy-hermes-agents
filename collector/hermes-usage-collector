# ── Transient-network resilience ─────────────────────────────────────────────
# The panel shows usageStatusText/authHelpText as a scary red banner and drops
# all limit meters whenever a limits fetch fails. A single DNS hiccup (e.g. the
# OnBootSec=30s run racing system DNS at boot) or a brief provider outage then
# wipes healthy data. Mitigate in three layers:
#   1. Retry transient failures once after 5s (covers post-boot DNS warmup).
#   2. On persistent failure, keep serving the last good limits from a cache
#      file (staleness capped at 2h; afterwards the error wins).
#   3. Tag the status text so the panel says "cached" instead of "unavailable".
# NOTE: keep this OUTSIDE the usage/ directory — the panel scans usage/ for
# *.json and would try to render the cache as a provider tab.
LIMITS_CACHE_PATH = Path.home() / ".local" / "state" / "omarchy" / "agents" / "limits-cache.json"
LIMITS_CACHE_MAX_AGE_S = 2 * 60 * 60  # 2h

# Usage endpoints (Anthropic's especially) answer 429 when probed too often.
# Every timer run, panel open and shell restart used to probe, so a few
# restarts in a row tripped the limit and blanked the meters. Three rules:
#   * reuse a probe younger than LIMITS_MIN_PROBE_INTERVAL_S (panel opens and
#     restarts right after a timer run cost nothing; --force skips this);
#   * after a 429, stay off the endpoint until Retry-After (at least
#     RATE_LIMIT_COOLDOWN_S) has passed -- --force does NOT skip this, a
#     click would only earn another 429;
#   * while rate limited, keep showing the last good limits (up to
#     RATE_LIMIT_CACHE_MAX_AGE_S) marked stale instead of a red banner.
LIMITS_MIN_PROBE_INTERVAL_S = 3 * 60
RATE_LIMIT_COOLDOWN_S = 10 * 60
RATE_LIMIT_CACHE_MAX_AGE_S = 12 * 60 * 60
RATE_LIMITED_STATUS = "Usage endpoint rate limited"

# Per provider: {"stale": bool, "fetchedAt": epoch ms} for the record's
# limitsStale / limitsFetchedAt fields (the stock panel shows the age).
LAST_FETCH_META = {}


def _is_rate_limited(status_text):
    return "rate limit" in str(status_text or "").lower()


def _retry_after_seconds(auth_help):
    import re
    match = re.search(r"retry after (\d+)s", str(auth_help or ""))
    return int(match.group(1)) if match else 0


def _is_transient_fetch_error(status_text, auth_help):
    """True when a fetch failure looks like a transient network problem
    (name resolution, connection, timeout) rather than bad credentials."""
    blob = f"{status_text} {auth_help}".lower()
    transient_markers = (
        "unavailable",          # "<Provider> API unavailable" / URLError branch
        "temporary failure",
        "name resolution",
        "name or service",
        "connection refused",
        "connection reset",
        "connection timed out",
        "timed out",
        "timeout",
        "ssl",
        "eof occurred",
        "remote end closed",
    )
    # Auth problems (invalid key, relogin) are never transient.
    if "invalid" in blob or "not authenticated" in blob or "relogin" in blob:
        return False
    return any(marker in blob for marker in transient_markers)


def _load_limits_cache():
    try:
        cached = json.loads(LIMITS_CACHE_PATH.read_text())
        if isinstance(cached, dict):
            return cached
    except Exception:
        pass
    return {}


def _store_cached_limits(cache, provider_id, entry):
    cache[provider_id] = entry
    try:
        tmp = LIMITS_CACHE_PATH.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(cache, indent=2))
        tmp.replace(LIMITS_CACHE_PATH)
    except Exception:
        pass  # cache is best-effort; never fail the collector over it


def _cached_entry(provider_id):
    entry = _load_limits_cache().get(provider_id)
    return entry if isinstance(entry, dict) else {}


def _serve_cached(provider_id, entry, max_age, live):
    """Cached limits if fresh enough, else None."""
    limits = entry.get("limits")
    stored = float(entry.get("storedAt") or 0)
    if not (isinstance(limits, list) and limits) or time.time() - stored > max_age:
        return None
    LAST_FETCH_META[provider_id] = {"stale": not live, "fetchedAt": int(stored * 1000)}
    return limits, entry.get("tierLabel") or ""


def _remember_success(provider_id, limits, tier_label):
    now = time.time()
    _store_cached_limits(
        _load_limits_cache(),
        provider_id,
        {"limits": limits, "tierLabel": tier_label, "storedAt": now},
    )
    LAST_FETCH_META[provider_id] = {"stale": False, "fetchedAt": int(now * 1000)}


def fetch_limits_resilient(provider_id, fetcher, auth, allow_retry=True, force=False):
    """Run a limits fetcher with probe throttling, rate-limit cooldown,
    one transient retry and stale-limit caching.

    Returns (limits, tier_label, status_text, auth_help).
    Set allow_retry=False when the caller already has its own retry loop
    (the panel's retryAdvised 30s retry calls us with --limits-only).
    """
    LAST_FETCH_META.pop(provider_id, None)
    entry = _cached_entry(provider_id)
    now = time.time()

    # Still cooling down from a 429: do not touch the endpoint at all.
    if float(entry.get("rateLimitedUntil") or 0) > now:
        served = _serve_cached(provider_id, entry, RATE_LIMIT_CACHE_MAX_AGE_S, live=False)
        if served:
            return served[0], served[1], "", ""
        return [], "", RATE_LIMITED_STATUS, "Showing local stats; limits return after the cooldown"

    # A recent probe is still the answer: panel opens and shell restarts
    # right after a timer run must not each cost a request.
    if not force:
        served = _serve_cached(provider_id, entry, LIMITS_MIN_PROBE_INTERVAL_S, live=True)
        if served:
            return served[0], served[1], "", ""

    limits, tier_label, status_text, auth_help = fetcher(auth)

    if limits or not status_text:
        _remember_success(provider_id, limits, tier_label)
        return limits, tier_label, status_text, auth_help

    if _is_rate_limited(status_text):
        cooldown = max(RATE_LIMIT_COOLDOWN_S, _retry_after_seconds(auth_help))
        entry = _cached_entry(provider_id)
        entry["rateLimitedUntil"] = now + cooldown
        _store_cached_limits(_load_limits_cache(), provider_id, entry)
        served = _serve_cached(provider_id, entry, RATE_LIMIT_CACHE_MAX_AGE_S, live=False)
        if served:
            return served[0], served[1], "", ""
        return [], tier_label, status_text, "Showing local stats; limits return after the cooldown"

    # Fetch failed: retry once for transient-looking errors (post-boot DNS
    # warmup typically resolves within a few seconds). Skipped when the
    # caller runs its own retry loop (panel --limits-only mode).
    if allow_retry and _is_transient_fetch_error(status_text, auth_help):
        time.sleep(5)
        limits, tier_label, status_text, auth_help = fetcher(auth)
        if limits or not status_text:
            _remember_success(provider_id, limits, tier_label)
            return limits, tier_label, status_text, auth_help

    # Still failing: serve cached limits if fresh enough AND the failure is
    # transient (network). Auth errors must surface honestly, not be masked
    # by stale meters.
    if not limits and status_text and _is_transient_fetch_error(status_text, auth_help):
        served = _serve_cached(provider_id, _cached_entry(provider_id), LIMITS_CACHE_MAX_AGE_S, live=False)
        if served:
            return served[0], served[1], f"{status_text} — showing cached limits", auth_help

    return limits, tier_label, status_text, auth_help


# ── Token usage from DB ──────────────────────────────────────────────────────


def _retry_advised(status_text, auth_help):
    """True when the panel should rerun this provider's limits fetch sooner.

    Only transient (network) failures advise a retry — the 30s panel retry
    then gives the fetch a second chance well before the next timer run.
    Auth errors advise nothing: a retry can't fix them.
    """
    return bool(status_text) and _is_transient_fetch_error(status_text, auth_help)


def collect_provider(conns, meta, auth):
    now = datetime.now().astimezone()
    today_str = now.strftime("%Y-%m-%d")
    recent_dates = [
        (now - timedelta(days=offset)).strftime("%Y-%m-%d")
        for offset in range(6, -1, -1)
    ]
    recent = {day: 0 for day in recent_dates}

    today_tokens_by_model = {}
    today_sessions = set()
    today_prompts = 0
    today_total_tokens = 0
    model_usage = {}
    active_dates = set()
    total_prompts = 0
    total_sessions = set()

    query = f"""
        SELECT
            smu.model,
            smu.input_tokens,
            smu.output_tokens,
            smu.cache_read_tokens,
            smu.cache_write_tokens,
            smu.api_call_count,
            smu.estimated_cost_usd,
            date(smu.first_seen, 'unixepoch', 'localtime') AS first_day,
            date(smu.last_seen, 'unixepoch', 'localtime') AS last_day,
            s.id AS session_id
        FROM session_model_usage smu
        JOIN sessions s ON s.id = smu.session_id
        WHERE {meta["where"]}
        """

    rows = []
    for db_idx, conn in enumerate(conns):
        db_rows = conn.execute(query, meta["params"]).fetchall()
        rows.extend((db_idx, row) for row in db_rows)

    for db_idx, row in rows:
        model, inp, outp, cr, cw, api_calls, cost, first_day, last_day, session_id = row
        session_key = (db_idx, session_id)
        inp = inp or 0
        outp = outp or 0
        cr = cr or 0
        cw = cw or 0
        total = inp + outp + cr + cw
        if total <= 0 and (api_calls or 0) <= 0:
            continue

        model_name = model or "unknown"

        bucket = model_usage.setdefault(model_name, empty_bucket())
        bucket["inputTokens"] += inp
        bucket["outputTokens"] += outp
        bucket["cacheReadInputTokens"] += cr
        bucket["cacheCreationInputTokens"] += cw

        prompts = max(api_calls or 0, 1)
        total_prompts += prompts
        total_sessions.add(session_key)

        if last_day:
            active_dates.add(last_day)
        if first_day:
            active_dates.add(first_day)

        if first_day and last_day:
            if first_day <= today_str <= last_day:
                today_prompts += prompts
                today_sessions.add(session_key)
                today_total_tokens += total
                today_tokens_by_model[model_name] = (
                    today_tokens_by_model.get(model_name, 0) + total
                )

        for day in recent_dates:
            if first_day and last_day and first_day <= day <= last_day:
                recent[day] += total

    # Fetch live limits (with transient retry + stale-limit caching so a
    # post-boot DNS hiccup or brief outage doesn't blank the panel).
    limits = []
    tier_label = meta["tierLabel"]
    status_text = ""
    auth_help = ""
    limits_fn_name = meta.get("limits_fn")
    if limits_fn_name and limits_fn_name in LIMIT_FETCHERS:
        limits, tier_label, status_text, auth_help = fetch_limits_resilient(
            meta["id"], LIMIT_FETCHERS[limits_fn_name], auth, force=FORCE
        )
    fetch_meta = LAST_FETCH_META.get(meta["id"], {})

    record = {
        "schemaVersion": 1,
        "id": meta["id"],
        "name": meta["name"],
        "updatedAt": datetime.now(timezone.utc).isoformat(),
        "ready": len(rows) > 0,
        "hasLocalStats": True,
        "hasPromptStats": True,
        "scope": meta.get("scope", "machine"),
        "tierLabel": tier_label,
        "usageStatusText": status_text,
        "authHelpText": auth_help,
        "retryAdvised": _retry_advised(status_text, auth_help),
        "limits": limits,
        "limitsStale": bool(fetch_meta.get("stale")),
        "limitsFetchedAt": int(fetch_meta.get("fetchedAt") or 0),
        "todayPrompts": today_prompts,
        "todaySessions": len(today_sessions),
        "todayTotalTokens": today_total_tokens,
        "todayTokensByModel": today_tokens_by_model,
        "recentDays": [
            {"date": day, "messageCount": recent[day]} for day in recent_dates
        ],
        "totalPrompts": total_prompts,
        "totalSessions": len(total_sessions),
        "activeDays": len(active_dates),
        "activeDates": sorted(active_dates),
        "modelUsage": model_usage,
    }

    return record


def _refresh_limits_only(meta, auth):
    """Re-fetch only the limits for one provider and patch them into the
    existing record on disk. Token stats stay untouched — this is what the
    panel's --limits-only mode (open-panel refresh and retryAdvised retry)
    calls us with.
    """
    out_path = USAGE_DIR / f"{meta['id']}.json"
    try:
        record = json.loads(out_path.read_text())
        if not isinstance(record, dict):
            raise ValueError("not an object")
    except Exception:
        # No usable record yet: fall back to a full collect.
        record = None
    if record is None:
        print(f"limits-only: no usable {out_path.name}, skipping")
        return

    # Panel-triggered limits-only run: the panel's own 30s retryAdvised
    # loop is the retry, so no in-process sleep here.
    limits, tier_label, status_text, auth_help = fetch_limits_resilient(
        meta["id"], LIMIT_FETCHERS[meta["limits_fn"]], auth,
        allow_retry=False, force=FORCE,
    )
    fetch_meta = LAST_FETCH_META.get(meta["id"], {})
    record["limitsStale"] = bool(fetch_meta.get("stale"))
    record["limitsFetchedAt"] = int(fetch_meta.get("fetchedAt") or 0)
    record["updatedAt"] = datetime.now(timezone.utc).isoformat()
    record["tierLabel"] = tier_label or record.get("tierLabel", "")
    record["usageStatusText"] = status_text
    record["authHelpText"] = auth_help
    record["retryAdvised"] = _retry_advised(status_text, auth_help)
    record["limits"] = limits

    tmp_path = USAGE_DIR / f".{meta['id']}.{os.getpid()}.tmp"
    tmp_path.write_text(json.dumps(record, indent=2) + "\n")
    tmp_path.replace(out_path)
    print(
        f"Patch {out_path.name} "
        f"(limits-only, {len(limits)} limits)"
    )


FORCE = False


def _parse_args(argv):
    """Parse the omarchy-agent-usage-update call convention:
    [--force] [--limits-only] [--except <id>]... [provider-id]...
    Returns (limits_only, only_ids, excluded_ids).
    """
    limits_only = False
    only_ids = set()
    excluded = set()
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--force":
            global FORCE
            FORCE = True  # skip the probe reuse window (not a 429 cooldown)
        elif arg == "--limits-only":
            limits_only = True
        elif arg == "--except":
            i += 1
            if i < len(argv):
                excluded.add(argv[i])
        else:
            only_ids.add(arg)
        i += 1
    return limits_only, only_ids, excluded


def main():
    limits_only, only_ids, excluded = _parse_args(sys.argv[1:])

    if not STATE_DB.exists():
        print(f"hermes-usage-collector: {STATE_DB} not found", file=sys.stderr)
        return 1

    USAGE_DIR.mkdir(parents=True, exist_ok=True)
    auth = load_auth()

    conns = [open_db_ro(p) for p in state_dbs()]
    try:
        for meta in PROVIDERS:
            if only_ids and meta["id"] not in only_ids:
                continue
            if meta["id"] in excluded:
                continue
            if limits_only:
                _refresh_limits_only(meta, auth)
                continue
            record = collect_provider(conns, meta, auth)
            out_path = USAGE_DIR / f"{meta['id']}.json"
            tmp_path = USAGE_DIR / f".{meta['id']}.{os.getpid()}.tmp"
            tmp_path.write_text(json.dumps(record, indent=2) + "\n")
            tmp_path.replace(out_path)
            print(
                f"Wrote {out_path.name} "
                f"({record['totalPrompts']} prompts, "
                f"{record['todayTotalTokens']} tokens today, "
                f"{len(record['limits'])} limits)"
            )
    finally:
        for conn in conns:
            conn.close()

    # Hermes overview + live local-model records (all local reads, cheap, so
    # --limits-only refreshes them whole). A failure here never costs the
    # provider records above.
    try:
        _overview_module().run(USAGE_DIR, only_ids, excluded)
    except Exception as exc:
        print(f"hermes-usage-collector: overview/local-live failed: {exc!r}", file=sys.stderr)

    return 0


def _overview_module():
    """overview.py sits next to this script in the repo and is deployed to
    ~/.local/lib/hermes-usage-collector/ (a bin dir is no place for modules)."""
    import importlib.util
    here = Path(os.path.realpath(__file__)).parent
    for cand in (here / "overview.py",
                 Path.home() / ".local" / "lib" / "hermes-usage-collector" / "overview.py"):
        if cand.exists():
            spec = importlib.util.spec_from_file_location("hermes_usage_overview", cand)
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            return mod
    raise FileNotFoundError("overview.py not found")


if __name__ == "__main__":
    sys.exit(main())