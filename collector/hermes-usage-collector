KIMI_USAGES_URL = "https://api.kimi.com/coding/v1/usages"

KIMI_LEVEL_LABELS = {
    "LEVEL_BASIC": "Basic",
    "LEVEL_ADVANCED": "Advanced",
    "LEVEL_PRO": "Pro",
}


def get_kimi_api_key(auth):
    """Find the Kimi API key.

    The auth.json credential pool entry only stores metadata
    (source: env:KIMI_API_KEY), so resolve the key from ~/.hermes/.env.
    """
    env = _parse_env_file(Path.home() / ".hermes" / ".env")
    return env.get("KIMI_API_KEY") or ""


def fetch_kimi_limits(auth):
    """Fetch weekly quota + 5h rate window from the Kimi Code usages API.

    Endpoint: GET https://api.kimi.com/coding/v1/usages
    Auth: Bearer KIMI_API_KEY (from ~/.hermes/.env).

    Response carries user.membership.level, a top-level weekly `usage`
    (limit/used/remaining/resetTime as strings), and a `limits` array with
    per-window rate limits (window.duration + timeUnit, detail.limit/used/
    remaining/resetTime).

    Returns (limits_list, tier_label, status_text, auth_help).
    """
    api_key = get_kimi_api_key(auth)
    if not api_key:
        return [], "", "Kimi key not found", "Set KIMI_API_KEY in ~/.hermes/.env"

    try:
        req = urllib.request.Request(
            KIMI_USAGES_URL,
            headers={
                "Authorization": f"Bearer {api_key}",
                "Accept": "application/json",
            },
        )
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = json.loads(resp.read())

        level = (data.get("user", {}).get("membership", {}) or {}).get("level", "")
        if level:
            pretty = KIMI_LEVEL_LABELS.get(level, level.replace("LEVEL_", "").capitalize())
            tier_label = f"Coding Plan · {pretty}"
        else:
            tier_label = "Coding Plan"

        def _detail(detail, label):
            try:
                limit = float(detail.get("limit", 0))
                used = float(detail.get("used", 0))
            except (TypeError, ValueError):
                return None
            if limit <= 0:
                return None
            resets_iso = ""
            reset_time = detail.get("resetTime", "")
            if reset_time:
                try:
                    resets_iso = datetime.fromisoformat(
                        reset_time.replace("Z", "+00:00")
                    ).isoformat()
                except Exception:
                    resets_iso = ""
            return {
                "label": f"{label} ({int(used)}/{int(limit)})",
                "percent": min(max(used / limit, 0.0), 1.0),
                "resetsAt": resets_iso,
            }

        limits = []

        # 5h rate window(s) from the limits array
        for item in data.get("limits", []):
            if not isinstance(item, dict):
                continue
            window = item.get("window", {}) or {}
            duration = window.get("duration")
            unit = window.get("timeUnit", "")
            if unit == "TIME_UNIT_MINUTE" and isinstance(duration, (int, float)):
                hours = duration / 60.0
                label = f"Session ({int(hours)}h)" if hours >= 1 else f"{int(duration)}m window"
            else:
                label = "Rate window"
            entry = _detail(item.get("detail", {}) or {}, label)
            if entry:
                limits.append(entry)

        # Weekly quota (top-level usage object)
        weekly = _detail(data.get("usage", {}) or {}, "Weekly")
        if weekly:
            limits.append(weekly)

        return limits, tier_label, "", ""
    except urllib.error.HTTPError as exc:
        if exc.code == 401:
            return [], "", "Kimi key invalid", "Check KIMI_API_KEY in ~/.hermes/.env"
        return [], "", f"Kimi API error ({exc.code})", ""
    except Exception as exc:
        return [], "", "Kimi API unavailable", str(exc)


NOUS_REAUTH_HELP = "Run `hermes auth add nous --type oauth`"


def _nous_state(auth):
    """Return (state_dict, is_pool) for Nous OAuth state.

    Fresh `hermes auth add nous` logins write tokens to the credential pool;
    older logins live under providers.nous. Prefer providers, fall back to
    the pool entry.
    """
    prov = (auth.get("providers") or {}).get("nous") or {}
    if prov.get("access_token"):
        return prov, False
    pool = (auth.get("credential_pool") or {}).get("nous") or []
    for entry in pool:
        if isinstance(entry, dict) and entry.get("access_token"):
            return entry, True
    return {}, False


def _nous_token_expired(state, margin_s=120):
    exp = state.get("expires_at") or ""
    if not exp:
        return False  # unknown; let the API call decide
    try:
        dt = datetime.fromisoformat(str(exp).replace("Z", "+00:00"))
    except Exception:
        return False
    return datetime.now(timezone.utc) >= dt - timedelta(seconds=margin_s)


def _nous_refresh_and_persist(state):
    """Refresh the Nous access token and persist the rotated tokens.

    Nous refresh tokens are SINGLE-USE and rotate on every refresh. If we
    refresh and do not write the rotated pair back to auth.json (both
    providers.nous and credential_pool.nous), the next Hermes refresh uses
    the retired token and the portal revokes the whole session as a
    token-theft signal. Persisting is therefore mandatory, not optional.

    Returns (new_access_token, None) on success or (None, error_message).
    """
    refresh_token = state.get("refresh_token") or ""
    if not refresh_token:
        return None, "no refresh token"
    portal_url = (state.get("portal_base_url") or "https://portal.nousresearch.com").rstrip("/")
    client_id = state.get("client_id") or "hermes-cli"

    body = urllib.parse.urlencode(
        {"grant_type": "refresh_token", "client_id": client_id}
    ).encode()
    req = urllib.request.Request(
        f"{portal_url}/api/oauth/token",
        data=body,
        headers={
            "x-nous-refresh-token": refresh_token,
            "Accept": "application/json",
            "Content-Type": "application/x-www-form-urlencoded",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            payload = json.loads(resp.read())
    except urllib.error.HTTPError as exc:
        try:
            err = json.loads(exc.read())
            code = str(err.get("error", ""))
            desc = str(err.get("error_description") or "")
        except Exception:
            code, desc = "", ""
        if code in ("invalid_grant", "invalid_token", "refresh_token_reused") or "reuse" in desc.lower():
            return None, "relogin"
        return None, f"refresh failed ({exc.code})"
    except Exception as exc:
        return None, f"refresh failed: {exc}"

    new_access = payload.get("access_token")
    if not new_access:
        return None, "relogin"
    new_refresh = payload.get("refresh_token") or refresh_token
    now = datetime.now(timezone.utc)
    try:
        ttl = float(payload.get("expires_in") or 3600)
    except (TypeError, ValueError):
        ttl = 3600
    new_expires = (now + timedelta(seconds=ttl)).isoformat()

    # Persist rotated tokens to BOTH auth.json locations, atomically.
    try:
        auth = json.loads(AUTH_JSON.read_text())
        prov = (auth.get("providers") or {}).get("nous")
        if isinstance(prov, dict) and prov.get("refresh_token") in (refresh_token, new_refresh, prov.get("refresh_token")):
            prov["access_token"] = new_access
            prov["refresh_token"] = new_refresh
            prov["obtained_at"] = now.isoformat()
            prov["expires_at"] = new_expires
            prov["expires_in"] = ttl
        pool = (auth.get("credential_pool") or {}).get("nous") or []
        for entry in pool:
            if isinstance(entry, dict) and entry.get("access_token"):
                entry["access_token"] = new_access
                entry["refresh_token"] = new_refresh
                entry["obtained_at"] = now.isoformat()
                entry["expires_at"] = new_expires
                entry["expires_in"] = ttl
        tmp = AUTH_JSON.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(auth, indent=2))
        tmp.chmod(0o600)
        tmp.replace(AUTH_JSON)
    except Exception as exc:
        return None, f"persist failed: {exc}"

    return new_access, None


def _nous_portal_account(access_token, portal_url):
    """GET /api/oauth/account. Raises urllib.error.HTTPError on HTTP errors."""
    req = urllib.request.Request(
        f"{portal_url.rstrip('/')}/api/oauth/account",
        headers={
            "Authorization": f"Bearer {access_token}",
            "Accept": "application/json",
        },
    )
    with urllib.request.urlopen(req, timeout=10) as resp:
        return json.loads(resp.read())


def fetch_nous_limits(auth):
    """READ-ONLY credits fetch from the Nous portal /api/oauth/account.

    NEVER refresh tokens here. Nous refresh tokens are single-use and
    rotate on every refresh; Hermes' own gateway/auth layer owns that
    rotation (cross-profile locking + shared-store protocol). A second
    refresher in this collector races it, replays a retired token, and
    the portal revokes the WHOLE account session family (verified
    2026-08-23: every re-login died within ~1h, panel flapped 56x/day).

    Returns (limits_list, tier_label, status_text, auth_help).
    """
    state, _ = _nous_state(auth)
    access_token = state.get("access_token", "")
    portal_url = state.get("portal_base_url", "https://portal.nousresearch.com")

    if not access_token:
        return [], "", "Nous not authenticated", NOUS_REAUTH_HELP

    try:
        data = _nous_portal_account(access_token, portal_url)
    except urllib.error.HTTPError as exc:
        if exc.code == 401:
            # Idle-expired access token: Hermes refreshes it on the next
            # real Nous use. Do NOT rotate from here.
            return [], "", "Nous token idle-expired (refreshes on next Hermes Nous use)", ""
        return [], "", f"Nous API error ({exc.code})", ""
    except Exception as exc:
        return [], "", "Nous API unavailable", str(exc)

    try:
        sub = data.get("subscription", {})
        plan = sub.get("plan", "")
        monthly_credits = float(sub.get("monthly_credits", 0))
        credits_remaining = float(sub.get("credits_remaining", 0))
        period_end = sub.get("current_period_end", "")

        tier_label = f"{plan} · ${sub.get('monthly_charge', 0)}/mo" if plan else ""

        if monthly_credits > 0:
            used = monthly_credits - credits_remaining
            percent = used / monthly_credits
        else:
            percent = 0

        # Parse the period end timestamp
        resets_at = ""
        if period_end:
            try:
                dt = datetime.fromisoformat(period_end.replace("Z", "+00:00"))
                resets_at = dt.isoformat()
            except Exception:
                resets_at = period_end

        limits = [
            {
                "label": f"Credits (${credits_remaining:.2f}/${monthly_credits:.0f})",
                "percent": min(max(percent, 0), 1.0),
                "resetsAt": resets_at,
            }
        ]

        return limits, tier_label, "", ""
    except Exception as exc:
        return [], "", "Nous API unavailable", str(exc)


ZAI_QUOTA_URL = "https://api.z.ai/api/monitor/usage/quota/limit"
# Quota limit types returned by the Z.AI monitor API:
#   unit 3 = hours  → 5-hour session quota (number = 5)
#   unit 6 = weeks  → weekly quota (number = 1)
ZAI_UNIT_LABELS = {(3, 5): "Session (5h)", (6, 1): "Weekly"}
ZAI_FALLBACK_LABELS = {3: "Session (5h)", 6: "Weekly"}


def _parse_env_file(path):
    env = {}
    try:
        for line in path.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                env[k.strip()] = v.strip().strip('"').strip("'")
    except Exception:
        pass
    return env


def get_zai_api_key(auth):
    """Find the Z.AI API key: credential pool entry (env-backed) or .env file."""
    pool = auth.get("credential_pool", {}).get("zai", [])
    for entry in pool:
        if isinstance(entry, dict):
            for field in ("access_token", "api_key", "apiKey", "secret", "token"):
                value = entry.get(field)
                if isinstance(value, str) and value:
                    return value
    env = _parse_env_file(Path.home() / ".hermes" / ".env")
    return env.get("GLM_API_KEY") or env.get("ZAI_API_KEY") or ""


def fetch_zai_limits(auth):
    """Fetch session (5h) + weekly quota usage from the Z.AI monitor API.

    Endpoint: GET https://api.z.ai/api/monitor/usage/quota/limit
    Auth: raw API key in the Authorization header (no Bearer prefix).

    Response limits entries carry: type (CREDIT_LIMIT), unit (3=hours,
    6=weeks), number (window size), usage (allowance), currentValue (used),
    remaining, percentage (0-100), nextResetTime (epoch milliseconds).

    Returns (limits_list, tier_label, status_text, auth_help).
    """
    api_key = get_zai_api_key(auth)
    if not api_key:
        return [], "", "Z.AI key not found", "Set GLM_API_KEY in ~/.hermes/.env"

    try:
        req = urllib.request.Request(
            ZAI_QUOTA_URL,
            headers={
                "Authorization": api_key,
                "Accept-Language": "en-US,en",
                "Content-Type": "application/json",
            },
        )
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = json.loads(resp.read())

        payload = data.get("data", data)
        raw_limits = payload.get("limits", [])
        level = payload.get("level", "")
        tier_label = f"Coding Plan · {level.capitalize()}" if level else "Coding Plan"

        limits = []
        for item in raw_limits:
            if not isinstance(item, dict):
                continue
            unit = item.get("unit")
            number = item.get("number")
            label = ZAI_UNIT_LABELS.get((unit, number)) or ZAI_FALLBACK_LABELS.get(
                unit, "Quota"
            )
            used = item.get("currentValue")
            allowance = item.get("usage")
            pct = item.get("percentage")
            if isinstance(pct, (int, float)):
                percent = float(pct) / 100.0
            elif isinstance(used, (int, float)) and isinstance(allowance, (int, float)) and allowance > 0:
                percent = used / allowance
            else:
                continue
            # Include allowance context in the label when available
            if isinstance(used, (int, float)) and isinstance(allowance, (int, float)):
                label = f"{label} ({used}/{allowance})"
            resets_iso = ""
            reset_ms = item.get("nextResetTime")
            if isinstance(reset_ms, (int, float)) and reset_ms > 0:
                try:
                    resets_iso = datetime.fromtimestamp(
                        reset_ms / 1000.0, timezone.utc
                    ).isoformat()
                except Exception:
                    resets_iso = ""
            limits.append({
                "label": label,
                "percent": min(max(percent, 0.0), 1.0),
                "resetsAt": resets_iso,
            })

        return limits, tier_label, "", ""
    except urllib.error.HTTPError as exc:
        if exc.code == 401:
            return [], "", "Z.AI key invalid", "Check GLM_API_KEY in ~/.hermes/.env"
        return [], "", f"Z.AI API error ({exc.code})", ""
    except Exception as exc:
        return [], "", "Z.AI API unavailable", str(exc)


def fetch_chatgpt_limits(auth):
    """Fetch rate limits from ChatGPT wham/usage API with Hermes-stored tokens.

    Returns (limits_list, tier_label, status_text, auth_help).
    Uses the openai-codex tokens from auth.json (auth_mode=chatgpt).
    """
    providers = auth.get("providers", {})
    oc = providers.get("openai-codex", {})
    tokens = oc.get("tokens", {})
    access_token = tokens.get("access_token", "")

    if not access_token:
        # Hermes stores fresh OAuth logins in the credential pool, not in the
        # legacy providers.openai-codex.tokens path.
        pool = auth.get("credential_pool", {}).get("openai-codex", [])
        for entry in pool:
            if not isinstance(entry, dict):
                continue
            access_token = entry.get("access_token", "")
            if access_token:
                break

    if not access_token:
        return [], "", "ChatGPT not authenticated", "Run `hermes auth add openai-codex --type oauth`"

    try:
        url = "https://chatgpt.com/backend-api/wham/usage"
        headers = {
            "Authorization": f"Bearer {access_token}",
            "Accept": "application/json",
            "User-Agent": "codex-cli",
        }
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, timeout=15) as resp:
            payload = json.loads(resp.read())

        plan = payload.get("plan_type") or ""
        tier_label = plan.capitalize() if plan else ""

        rate_limit = payload.get("rate_limit") or {}
        limits = []

        for key, label in (("primary_window", "Weekly (7-day)"), ("secondary_window", "Secondary")):
            window = rate_limit.get(key)
            if not isinstance(window, dict):
                continue
            used = window.get("used_percent")
            if used is None:
                continue
            window_seconds = int(window.get("limit_window_seconds") or 0)
            if window_seconds:
                hours = window_seconds // 3600
                if hours >= 168:
                    label = "Weekly (7-day)"
                elif hours > 0:
                    label = f"{hours}h window"
                else:
                    label = f"{window_seconds // 60}m window"
            reset_at = window.get("reset_at")
            resets_iso = ""
            if reset_at:
                try:
                    resets_iso = datetime.fromtimestamp(int(reset_at), timezone.utc).isoformat()
                except Exception:
                    resets_iso = str(reset_at)
            limits.append({
                "label": label,
                "percent": float(used) / 100.0,
                "resetsAt": resets_iso,
            })

        return limits, tier_label, "", ""
    except urllib.error.HTTPError as exc:
        if exc.code == 401:
            # Idle-expired access token (10-day JWT TTL, Hermes refreshes
            # lazily on the next real openai-codex use). Verified 2026-09-02:
            # panel said "token expired" while Hermes auth was fine; one
            # one-shot `hermes -z ... --provider openai-codex` call rotated
            # the token and the meter recovered. Re-login (`hermes auth add
            # openai-codex --type oauth`) is only needed when the refresh
            # chain itself is revoked (refresh_token_reused in
            # providers.openai-codex.last_auth_error) — do not suggest it
            # for a plain idle expiry.
            return [], "", "ChatGPT token idle-expired (refreshes on next Hermes use)", ""
        return [], "", f"ChatGPT API error ({exc.code})", ""
    except Exception as exc:
        return [], "", "ChatGPT API unavailable", str(exc)


